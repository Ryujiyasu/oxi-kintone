{
  "文書番号": { "type": "SINGLE_LINE_TEXT", "code": "文書番号", "label": "文書番号" },
  "顧客名": { "type": "SINGLE_LINE_TEXT", "code": "顧客名", "label": "顧客名", "required": true },
  "顧客担当者": { "type": "SINGLE_LINE_TEXT", "code": "顧客担当者", "label": "顧客担当者" },
  "件名": { "type": "SINGLE_LINE_TEXT", "code": "件名", "label": "件名" },
  "発行日": { "type": "DATE", "code": "発行日", "label": "発行日", "defaultNowValue": true },
  "納品日": { "type": "DATE", "code": "納品日", "label": "納品日" },
  "支払期限": { "type": "DATE", "code": "支払期限", "label": "支払期限" },
  "明細": {
    "type": "SUBTABLE", "code": "明細", "label": "明細",
    "fields": {
      "品名": { "type": "SINGLE_LINE_TEXT", "code": "品名", "label": "品名" },
      "数量": { "type": "NUMBER", "code": "数量", "label": "数量", "digit": true },
      "単位": { "type": "SINGLE_LINE_TEXT", "code": "単位", "label": "単位" },
      "単価": { "type": "NUMBER", "code": "単価", "label": "単価", "digit": true, "unit": "円", "unitPosition": "AFTER" },
      "金額": { "type": "CALC", "code": "金額", "label": "金額", "expression": "数量*単価", "format": "NUMBER_DIGIT", "unit": "円", "unitPosition": "AFTER" }
    }
  },
  "小計": { "type": "CALC", "code": "小計", "label": "小計", "expression": "SUM(金額)", "format": "NUMBER_DIGIT", "unit": "円", "unitPosition": "AFTER" },
  "消費税": { "type": "CALC", "code": "消費税", "label": "消費税（10%）", "expression": "ROUNDDOWN(小計*0.1, 0)", "format": "NUMBER_DIGIT", "unit": "円", "unitPosition": "AFTER" },
  "合計": { "type": "CALC", "code": "合計", "label": "合計", "expression": "小計+消費税", "format": "NUMBER_DIGIT", "unit": "円", "unitPosition": "AFTER" },
  "備考": { "type": "MULTI_LINE_TEXT", "code": "備考", "label": "備考" },
  "帳票": { "type": "FILE", "code": "帳票", "label": "帳票（作成した PDF）" }
}
